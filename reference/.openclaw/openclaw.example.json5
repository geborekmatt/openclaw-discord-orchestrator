{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace"
    },
    "list": [
      {
        "id": "main",
        "default": true,
        "name": "Main"
      },
      {
        "id": "cody",
        "name": "Cody",
        "workspace": "~/.openclaw/workspace-cody"
      },
      {
        "id": "bizzy",
        "name": "Bizzy",
        "workspace": "~/.openclaw/workspace-bizzy"
      }
    ]
  },
  "bindings": [],
  "channels": {
    "discord": {
      "enabled": true,
      "token": {
        "source": "env",
        "provider": "default",
        "id": "DISCORD_BOT_TOKEN"
      },
      "dmPolicy": "allowlist",
      "groupPolicy": "allowlist",
      "allowFrom": [
        "<DISCORD_USER_ID>"
      ],
      "guilds": {
        "<DISCORD_GUILD_ID>": {
          "users": [
            "<DISCORD_USER_ID>"
          ]
        }
      }
    }
  },
  "gateway": {
    "mode": "local"
  }
}
